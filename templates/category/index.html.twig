{% extends 'base.html.twig' %}


{% block body %}

 <table class="table table-dark table-striped table-hover table-bordered my-4">
  <thead>
    <tr>
      <th scope="col">id</th>
      <th scope="col">Name</th>
      <th scope="col">Content</th>
    </tr>
  </thead>
 
{% for category in categories %}
<tbody>
    <tr>
      <th scope="row">{{ category.id }}</th>
      <td>{{ category.name }}</td>
      <td>{{ category.content }}</td>
  </tbody>
{% endfor %}

</table>

{% endblock %}