{% extends 'base.html.twig' %}


{% block body %}

 <table class="table table-dark table-striped table-hover table-bordered my-4">
  <thead>
    <tr>
      <th scope="col">id</th>
      <th scope="col">Title</th>
      <th scope="col">Content</th>
    </tr>
  </thead>
 
{% for post in posts %}
<tbody>
    <tr>
      <th scope="row">{{ post.id }}</th>
      <td>{{ post.title }}</td>
      <td>{{ post.content }}</td>
  </tbody>
{% endfor %}

</table>

{% endblock %}